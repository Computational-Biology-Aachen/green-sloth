{
  "name": "greensloth",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "generate:mxl": "vite-node scripts/generate-mxl.ts",
    "validate:models": "vite-node scripts/validate-models.ts",
    "sync:names": "vite-node scripts/sync-names.ts"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": ">=10.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/load-config": ">=0.2.2",
    "@sveltejs/vite-plugin-svelte": ">=7.3.1",
    "@types/node": "^26.6.4",
    "@types/papaparse": "^5.5.2",
    "eslint": ">=10.12.0",
    "eslint-config-prettier": ">=10.0.0",
    "eslint-plugin-svelte": ">=3.20.0",
    "globals": ">=17.13.0",
    "image-size": "^2.0.4",
    "prettier": ">=3.9.9",
    "prettier-plugin-css-order": ">=2.2.0",
    "prettier-plugin-svelte": ">=4.1.1",
    "svelte": ">=5.57.1",
    "svelte-check": ">=4.7.5",
    "typescript": ">=6.0.0",
    "typescript-eslint": ">=8.71.0",
    "vite": ">=8.3.2",
    "vite-node": ">=4.0.0",
    "vite-plugin-wasm": ">=3.3.0",
    "vitest": ">=5.0.3"
  },
  "dependencies": {
    "@computational-biology-aachen/design": "github:Computational-Biology-Aachen/design",
    "@computational-biology-aachen/mxlweb-core": "github:Computational-Biology-Aachen/mxlweb-core",
    "@fortawesome/free-brands-svg-icons": ">=7.2.0",
    "@fortawesome/free-solid-svg-icons": ">=7.2.0",
    "@sveltejs/adapter-static": ">=4.0.0",
    "ajv": ">=8.18",
    "chart.js": "^4.5.1",
    "chroma-js": "^3.1.2",
    "katex": "^0.19.0",
    "papaparse": "^5.7.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "svelte-exmarkdown": "^5.0.2",
    "wat-compiler": "^1.1.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
